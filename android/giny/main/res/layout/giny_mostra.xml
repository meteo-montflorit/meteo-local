<!-- La mostra del giny al selector d'Android 12 o posterior (ADR 0131): el mitjà alt, amb un dia d'exemple. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/giny_arrel"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/giny_marc"
    android:clipToOutline="true">
    <ImageView
        android:id="@+id/giny_fons"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:src="@drawable/giny_fons_poc"
        android:scaleType="centerCrop"
        android:importantForAccessibility="no" />
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingTop="14dp"
        android:paddingEnd="14dp"
        android:paddingBottom="14dp">
        <TextView
            android:id="@+id/giny_titol"
            style="@style/GinyTitol"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/giny_titol"
            android:textColor="#FF1F3A57" />
        <TextView
            android:id="@+id/giny_frase"
            style="@style/GinyFrase"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:maxLines="3"
            android:text="@string/giny_mostra_frase"
            android:textColor="#FF0D2340"
            android:textSize="16sp" />
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:gravity="bottom"
            android:orientation="horizontal">
            <TextView
                android:id="@+id/giny_temp"
                style="@style/GinyTemp"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:includeFontPadding="false"
                android:text="16 °C"
                android:textColor="#FF0D2340"
                android:textSize="44sp" />
            <ImageView
                android:id="@+id/giny_cel"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:src="@drawable/giny_cel_partly_cloudy_day"
                android:importantForAccessibility="no" />
        </LinearLayout>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">
            <TextView
                android:id="@+id/giny_quan"
                style="@style/GinySuau"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="4dp"
                android:maxLines="1" />
            <TextView
                android:id="@+id/giny_extrems"
                style="@style/GinySuau"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:maxLines="1"
                android:text="@string/giny_mostra_dia"
                android:textColor="#FF1F3A57" />
            <TextView
                android:id="@+id/giny_extrems_vora"
                style="@style/GinySuau"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:maxLines="1"
                android:shadowColor="#FFFFFFFF"
                android:shadowRadius="4"
                android:visibility="gone" />
            <TextView
                android:id="@+id/giny_compara"
                style="@style/GinySuau"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1" />
        </LinearLayout>
        <TextView
            android:id="@+id/giny_compara2"
            style="@style/GinySuau"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:visibility="gone" />
    </LinearLayout>
</FrameLayout>
