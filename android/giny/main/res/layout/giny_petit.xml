<!-- El giny petit (ADR 0131): el lloc, el dibuix del cel, la temperatura i la màxima i la mínima. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/giny_arrel"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/giny_marc"
    android:clipToOutline="true">
    <ImageView
        android:id="@+id/giny_fons"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:importantForAccessibility="no" />
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="12dp">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">
            <TextView
                android:id="@+id/giny_titol"
                style="@style/GinyTitol"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:maxLines="2" />
            <ImageView
                android:id="@+id/giny_cel"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:importantForAccessibility="no" />
        </LinearLayout>
        <!-- La frase, només si el giny és alt (2×3 o més): la mostra GinyProvider. -->
        <TextView
            android:id="@+id/giny_frase"
            style="@style/GinyFrase"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:maxLines="6"
            android:textSize="14sp"
            android:visibility="gone" />
        <!-- Un buit que empeny la temperatura avall («Space» no es pot fer servir en un giny). -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />
        <TextView
            android:id="@+id/giny_temp"
            style="@style/GinyTemp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:includeFontPadding="false"
            android:textSize="38sp" />
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">
                <TextView
                    android:id="@+id/giny_extrems"
                    style="@style/GinySuau"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-medium" />
                <TextView
                    android:id="@+id/giny_extrems_vora"
                    style="@style/GinySuau"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-medium"
                    android:shadowColor="#FFFFFFFF"
                    android:shadowRadius="4"
                    android:visibility="gone" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
