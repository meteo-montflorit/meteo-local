<!-- El giny gran (ADR 0131): com la targeta d'«Ara» de la web. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/giny_arrel"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/giny_marc"
    android:clipToOutline="true">
    <ImageView
        android:id="@+id/giny_fons"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:importantForAccessibility="no" />
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="16dp">
        <TextView
            android:id="@+id/giny_titol"
            style="@style/GinyTitol"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />
        <TextView
            android:id="@+id/giny_frase"
            style="@style/GinyFrase"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:maxLines="3" />
        <TextView
            android:id="@+id/giny_linia"
            style="@style/GinySuau"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:maxLines="2" />
        <TextView
            android:id="@+id/giny_pastilles"
            style="@style/GinySuau"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:maxLines="1"
            android:visibility="gone" />
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:gravity="bottom"
            android:orientation="horizontal">
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">
                <TextView
                    android:id="@+id/giny_temp"
                    style="@style/GinyTemp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:includeFontPadding="false"
                    android:textSize="52sp" />
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">
                <TextView
                    android:id="@+id/giny_quan"
                    style="@style/GinySuau"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="4dp" />
                <TextView
                    android:id="@+id/giny_extrems"
                    style="@style/GinySuau"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-medium"
                    android:maxLines="1" />
                <TextView
                    android:id="@+id/giny_extrems_vora"
                    style="@style/GinySuau"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-medium"
                    android:shadowColor="#FFFFFFFF"
                    android:shadowRadius="4"
                    android:visibility="gone" />
            </LinearLayout>
                <TextView
                    android:id="@+id/giny_compara"
                    style="@style/GinySuau"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:maxLines="1" />
                <TextView
                    android:id="@+id/giny_compara2"
                    style="@style/GinySuau"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:maxLines="1"
                    android:visibility="gone" />
            </LinearLayout>
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_horizontal"
                android:orientation="vertical">
                <ImageView
                    android:id="@+id/giny_cel"
                    android:layout_width="88dp"
                    android:layout_height="88dp"
                    android:importantForAccessibility="no" />
                <TextView
                    android:id="@+id/giny_sol"
                    style="@style/GinyPetit"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:visibility="gone" />
                <LinearLayout
                    android:id="@+id/giny_lluna"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:visibility="gone">
                    <ImageView
                        android:id="@+id/giny_lluna_dibuix"
                        android:layout_width="13dp"
                        android:layout_height="13dp"
                        android:layout_marginEnd="4dp"
                        android:importantForAccessibility="no" />
                    <TextView
                        android:id="@+id/giny_lluna_text"
                        style="@style/GinyPetit"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
