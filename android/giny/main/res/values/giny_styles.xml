<!-- Els textos del giny (ADR 0131), amb la lletra del sistema. El color el posa el giny segons el cel. -->
<resources>
    <style name="GinyTitol">
        <item name="android:textSize">12sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:maxLines">1</item>
        <item name="android:ellipsize">end</item>
        <item name="android:textColor">#FFC9D8EE</item>
    </style>
    <style name="GinyFrase">
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:ellipsize">end</item>
        <item name="android:lineSpacingMultiplier">1.05</item>
        <item name="android:textColor">#FFFFFFFF</item>
    </style>
    <style name="GinyTemp">
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:letterSpacing">-0.03</item>
        <item name="android:maxLines">1</item>
        <item name="android:textColor">#FFFFFFFF</item>
    </style>
    <style name="GinySuau">
        <item name="android:textSize">13sp</item>
        <item name="android:ellipsize">end</item>
        <item name="android:textColor">#FFC9D8EE</item>
    </style>
    <style name="GinyPetit">
        <item name="android:textSize">12sp</item>
        <item name="android:maxLines">1</item>
        <item name="android:textColor">#FFC9D8EE</item>
    </style>
</resources>
